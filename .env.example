# Comma-separated owner emails. Owners are flagged on first login.
ADMIN_EMAILS=you@example.com
# Base URL used in magic links.
APP_URL=http://localhost:3000
# Optional: path to the SQLite file.
DATABASE_PATH=./data/shop.db
# Mock checkout charges nothing. Set STRIPE_SECRET_KEY to wire real payments
# (see README "Going live: Stripe" seam).
# STRIPE_SECRET_KEY=
# Mock email prints a dev login link. Set EMAIL_API_KEY to send real mail
# (see README "Going live: email" seam).
# EMAIL_API_KEY=
